#! /usr/bin/env bash

set -e

CONFIG="${CONFIG:-$HOME/.config/kubux-mail-client/smtp-config.toml}"
LOCKFILE="$HOME/.maildir/.postprocess.lock"

log() {
    local tag="$1"
    shift
    echo "[$(date +%H:%M:%S)] [$tag] $*"
}

usage() {
    echo "Usage: $(basename "$0") <account1> [<account2> ...]"
    exit 1
}

get_channel() {
    local account="$1"
    local channel
    channel=$(grep -A10 "^\[from\.\"$account\"\]" "$CONFIG" | grep -m1 mbsync_channel | sed 's/.*= *"\(.*\)"/\1/')
    echo "${channel:-$account}"
}

imap_worker() {
    local account="$1"
    local channel
    channel=$(get_channel "$account")
    log "$account" "watching channel $channel"
    while true; do
        pause-imap-sync --config "$CONFIG" --from "$account" || true
        log "$account" "event detected, acquiring lock..."
        (
            flock -x 200
            log "$account" "syncing channel $channel"
            mbsync-and-decrypt "$channel"
            log "$account" "running notmuch new"
            notmuch new
            log "$account" "done"
        ) 200>"$LOCKFILE"
    done
}

ai_train_loop() {
    while true; do
        sleep 900
        if [ $((RANDOM % 1000)) -lt 3 ]; then
            (
                flock -x 200
                log "ai-train" "training..."
                ai-train
                log "ai-train" "done"
            ) 200>"$LOCKFILE"
        fi
    done
}

check_postponed_loop() {
    while true; do
        sleep 3600
        (
            flock -x 200
            log "check-postponed" "checking..."
            check-postponed
            log "check-postponed" "done"
        ) 200>"$LOCKFILE"
    done
}

[ $# -ge 1 ] || usage

PIDS=()

for account in "$@"; do
    imap_worker "$account" &
    PIDS+=($!)
done

ai_train_loop &
PIDS+=($!)
check_postponed_loop &
PIDS+=($!)

trap 'log "main" "shutting down..."; kill ${PIDS[@]} 2>/dev/null; exit' SIGINT SIGTERM
wait