#! /usr/bin/env bash

SCRIPT_DIR=$( dirname $( realpath "${BASH_SOURCE[0]}" ) )
DECRYPT="${SCRIPT_DIR}/decrypt-on-the-fly"

CHANNEL="${1:-}"

tempfile=$(mktemp)
trap 'rm -f "$tempfile"' EXIT
touch "$tempfile"

if [ -n "$CHANNEL" ]; then
    mbsync "$CHANNEL"
else
    mbsync -a
fi

find ${HOME}/.maildir -type f -newer "$tempfile" -exec "${DECRYPT}" {} \;